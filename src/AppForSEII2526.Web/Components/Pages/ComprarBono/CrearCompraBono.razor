@page "/comprarbono/crearcomprabono"

@inject NavigationManager navigation
@using AppForSEII2526.Web.Components.Shared
@using AppForSEII2526.Web.API
@inject AppForSEII2526APIClient apiclient
@inject ILogger<CrearCompraBono> logger
@inject ComprarBonosStateContainer compraBonoState

<h3>Crear Compra Bono</h3>

<EditForm Model="compraBono" OnValidSubmit="OpenDialog">
    <div class="row">

        <DataAnnotationsValidator />
        <ValidationSummary />
    </div>
    <div class="row alert alert-danger" role="alert" hidden="@hideErrors">
        <p id="ErrorsShown">Errors: @messageError</p>
    </div>
    <div class="row g-3">
        <div class="col-md">
            <div class="form-floating mb-3">
                <InputText @bind-Value="compraBono.Nombre" class="form-control" id="Nombre" />
                <label for="Nombre">Nombre </label>
            </div>
        </div>
        <div class="col-md">
            <div class="form-floating mb-3">
                <InputText @bind-Value="compraBono.Apellido1" class="form-control" id="Primer Apellido" />
                <label for="Primer Apellido">Primer Apellido </label>
            </div>
        </div>
        <div class="col-md">
            <div class="form-floating mb-3">
                <InputText @bind-Value="compraBono.Apellido2" class="form-control" id="Segundo Apellido" />
                <label for="Segundo Apellido">Segundo Apellido </label>
            </div>
        </div>
        <div class="col-md">
            <div class="form-floating mb-3">
                <InputSelect @bind-Value="compraBono.MetodoPago" class="form-control form-select" id="MetodoPago">
                    <option value="">-- Seleccione método --</option>
                    @foreach (var metodo in Enum.GetValues(typeof(EnumMetodosPago)))
                    {
                        <option value="@metodo">@metodo</option>
                    }
                </InputSelect>
                <label for="MetodoPago">Método de Pago</label>
            </div>
        </div>
        <div class="col-md">
            <div class="form-floating">
                @*this button will be used to ask the user if he want to proceed to rent the movies*@
                <button class="btn btn-primary" type="submit" id="Submit">
                    Compra tus bonos
                </button>
            </div>
        </div>
    </div>
    <h4>Compra Bono detail</h4>
    <p>
        <b>Total price:</b> @TotalCost €
        <button class="btn btn-outline-primary" type="submit" @onclick="ModifyCompraBonos" id="ModifyCompraBonos">
            Modifica tus bonos
        </button>
    </p>

    <div class="mh-100 table-responsive">
        <table class="table table-condensed table-hover" id="TableOfCompraBonosItems">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Precio</th>
                    <th>Numero de bocadillos</th>
                    <th>Tipo de bocadillo</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in compraBono.ItemsCompraBono)
                {
                    <tr id="BonoData_@item.Nombre">
                        <td>@item.Nombre</td>
                        <td>@item.PrecioPorBono</td>
                        <td>@item.NumeroBocadillos</td>
                        <td>@item.TipoBocadillo</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</EditForm>

@if (DialogIsOpen)
{
    <Dialog Caption="Compra Bonos"
    Message="Do you want to proceed to buy the selected bonos?"
    OnClose="@OnDialogClose"
    Type=Dialog.Category.SaveNot>
    </Dialog>
}


@code {

    private string messageError = "";
    private bool hideErrors { get { return messageError.Length == 0; } }
    private bool DialogIsOpen;

    private decimal TotalCost
    {
        get
        {
            double price = compraBono.ItemsCompraBono.Sum(cb => cb.Cantidad * cb.PrecioPorBono);
            return Convert.ToDecimal(price);
        }
    }
    private void ModifyCompraBonos()
    {
        navigation.NavigateTo("/comprarbono/selectbonosforcompra");
    }


    private BonosForCreateDTO compraBono => compraBonoState.CompraBono;


    private void OpenDialog()
    {
        DialogIsOpen = true;
    }

    private async Task OnDialogClose(bool isOk)
    {

        DialogIsOpen = false;
        if (isOk)
        {
            // Process the data introduced by the user if they are valid
            if (compraBono.ItemsCompraBono.Count > 0)
            {
                try
                {
                    var comprado = await apiclient.CrearCompraAsync(compraBono);
                    compraBonoState.FinalizarCompraBono();
                    navigation.NavigateTo($"/comprarbono/detallecomprabono/?RentalID={comprado.Id}");
                }
                catch (ApiException apiexception)
                {
                    //we need to inform user that there was some other error while processing the request
                    messageError = "Error while processing your request, please try again later!";

                }
            }
        }
    }
}