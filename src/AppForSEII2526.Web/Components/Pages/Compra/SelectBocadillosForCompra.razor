@page "/compra/selectbocadillosforcompra"

@using AppForSEII2526.Web.API
@inject AppForSEII2526APIClient apiclient
@inject ILogger<SelectBocadillosForCompra> logger
@inject CompraStateContainer compraState
@inject NavigationManager navigation

<h3>Seleccionar Bocadillo Para Comprar</h3>

<div class="container-fluid">
    <div class="row" hidden="@hideErrors">
        <div class="row alert alert-danger" role="alert" hidden="@hideErrors">
            <p id="ErrorsShown">Errors: @errors</p>
        </div>
    </div>
    <div class="row">
        <div class="col-8">
            <div class="row">

                <div class="col">
                    <div class="input-group mb-3">
                        <span class="input-group-text" id="basic-addon1">Tamaño</span>
                        <input type="text" id="inputTamano" @bind=bocadilloTamano class="form-control" placeholder="Tamaño" aria-label="Tamaño" aria-describedby="basic-addon1">
                    </div>
                </div>
                <div class="col">
                    <div class="input-group mb-3">
                        <span class="input-group-text" id="basic-addon1">Tipo Pan</span>
                        <input type="text" id="inputTipopan" @bind=bocadilloTipoPan class="form-control" placeholder="TipoPan" aria-label="TipoPan" aria-describedby="basic-addon1">
                    </div>
                </div>

                <div class="col">                                           <!--IMPORTANTE-->
                    <button type="button" class="btn btn-primary" @onclick=@buscarBocadillos id="buscarBocadillos">Buscar bocadillos</button>
                </div>
            </div>
            <div class="row">
                @if (bocadillos == null)
                {
                    <p>Cargando bocadillos....</p>
                }
                else
                {
                    <div class="mh-100 table-responsive">
                        <table class="table table-condensed table-hover" id="TableOfBocadillos">
                            <thead>
                                <tr>
                                    <th>Nombre</th>
                                    <th>Tipo de pan</th>
                                    <th>Tamaño</th>
                                    <th>Precio</th>
                                    <th>Comprar</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var bocadillo in bocadillos)
                                {
                                    <tr id="BocadilloData_@bocadillo.Nombre">
                                        <td>@bocadillo.Nombre</td>
                                        <td>@bocadillo.TipoPan</td>
                                        <td>@bocadillo.Tamano</td>
                                        <td>@bocadillo.Precio</td>
                                        <td>
                                            <button class="btn btn-outline-secondary" id="bocadilloToCompra_@bocadillo.Nombre" @onclick="@(() => AddBocadillo(bocadillo))">Add</button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                }
            </div>
        </div>
        <div class="col-2" hidden="@hideCompraCart">
            <div class="row">
                <h3>Carrito Compra</h3>
            </div>
            @foreach (CompraItemDTO item in compra.CompraItems)
            {
                <div class="row">
                    <button type="button" class="btn btn-light" id="removeBocadillo_@item.Nombre" @onclick="@(() => RemoveCompraItem(item))">x @item.Nombre - @item.PrecioUnitario€</button>
                </div>
            }
            <div class="row">
                <button type="button" class="btn btn-primary" id="compraBocadilloButton" @onclick=@CompraBocadillos>Comprar Bocadillos</button>
            </div>
        </div>

    </div>

</div>

@code {
    private ICollection<BocadilloForCompraDTO> bocadillos;
    private bool hideErrors { get { return errors.Length == 0; } }
    private string errors = "";
    private Tamano? bocadilloTamano { get; set; }
    private string bocadilloTipoPan { get; set; }
    private bool hideCompraCart { get { return compra.CompraItems.Count == 0; } }

    private CompraForCreateDTO compra => compraState.Compra;

    private bool hiddenCompraCart = true;

    protected override async Task OnInitializedAsync()
    {
        await buscarBocadillos();
    }

    private void AddBocadillo(BocadilloForCompraDTO bocadillo)
    {
        compraState.AddBocadilloToCompra(bocadillo);
    }

    private void RemoveCompraItem(CompraItemDTO item)
    {
        compraState.RemoveCompraItemToCompra(item);
        if (compra.CompraItems.Count == 0) hiddenCompraCart = true;
    }

    public async Task buscarBocadillos()
    {
        try
        {
            bocadillos = await apiclient.GetBocadillosForCompraAsync(bocadilloTamano, bocadilloTipoPan);
            errors = "";
        }
        catch (ApiException ex)
        {
            logger.LogError($"{DateTime.Now} Error: {ex}");
            errors = "Error while connecting to the system";
        }
        StateHasChanged();
    }
    
    private void CompraBocadillos()
    {
        navigation.NavigateTo("/compra/createcompra");
    }
}
