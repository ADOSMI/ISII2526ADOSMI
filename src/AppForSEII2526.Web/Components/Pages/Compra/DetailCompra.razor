@page "/compra/detailcompra"
@using AppForSEII2526.Web.API
@inject AppForSEII2526APIClient apiclient

<h3>DetailCompra</h3>

@if (compra == null)
{
    <p>@error</p>
}
else
{
    <table class="table table-borderless table-sm">
        <tr>
            <th>Nombre completo cliente</th>
            <td id="NameSurname">@compra.NombreCliente @compra.Apellido1Cliente </td>
        </tr>
        <tr>
            <th>Payment Method</th>
            <td id="PaymentMethod">@compra.EnumeracionMetodosPago</td>
        </tr>
        <tr>
            <th>Fecha de compra</th>
            <td id="RentalDate">@compra.FechaCompra.ToString("dd/MM/yyyy hh:mm:ss")</td>
        </tr>

    </table>

    <h4>Bocadillos comprados</h4>

    <table class="table" id="RentedMovies">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Tipo de pan</th>
                <th>Precio</th>
                <th>Cantidad</th>
            </tr>
        </thead>
        <tbody>
            @foreach (CompraItemDTO item in compra.CompraItems)
            {
                <tr id="BocadilloData_@item.Nombre">
                    <td>@item.Nombre</td>
                    <td>@item.TipoPan</td>
                    <td>@item.PrecioUnitario</td>
                    <td>@item.Cantidad</td>
                </tr>
            }
        </tbody>
        <tfoot>
            @*colspan is used to state that TWO columns are collapsed*@
        <th scope="row" colspan="2" class="text-end">Precio total</th>
        <td id="TotalPrice">@compra.PrecioTotal €</td>
        </tfoot>

    </table>
}

@code {
    [Parameter]
    [SupplyParameterFromQuery]
    public int CompraID { get; set; }
    private CompraDetailDTO compra;
    private string error = "";


    [CascadingParameter]
    private Task<AuthenticationState>? authenticationState { get; set; }


    protected override async Task OnInitializedAsync()
    {

        try
        {
            compra = await apiclient.GetCompraAsync(CompraID);
        }
        catch (ApiException exception)
        {
            compra = null;
        }
    }

}
