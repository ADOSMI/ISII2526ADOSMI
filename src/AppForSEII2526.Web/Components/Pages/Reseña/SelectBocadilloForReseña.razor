@page "/Reseña/SelectBocadilloForReseña"

@using Microsoft.AspNetCore.Authorization
@using AppForSEII2526.Web.API
@* Asegúrate de tener el using correcto para ReseñaItemDTO *@

@inject AppForSEII2526APIClient apiclient
@inject ILogger<SelectBocadilloForReseña> logger
@inject CrearReseñaStateContainer estadoReseña
@inject NavigationManager navigation


<h3>Crear Reseña: Seleccionar Bocadillos</h3>

<div class="container-fluid">
    @* ZONA DE ERRORES (Copiado del modelo) *@
    <div class="row alert alert-danger" role="alert" hidden="@hideErrors">
        <p id="ErrorsShown">Errors: @errors</p>
    </div>

    <div class="row">
        @* COLUMNA IZQUIERDA (8): FILTROS Y TABLA *@
        <div class="col-8">
            <div class="row">
                @* Filtro Nombre *@
                <div class="col">
                    <div class="input-group mb-3">
                        <span class="input-group-text" id="basic-addon1">Nombre</span>
                        @* Adaptado: binding simple, la búsqueda se hace con el botón *@
                        <input type="text" id="inputNombre" @bind="filtroNombre" class="form-control" placeholder="Nombre" aria-label="Nombre">
                    </div>
                </div>

                @* Filtro PVP *@
                <div class="col">
                    <div class="input-group mb-3">
                        <span class="input-group-text" id="basic-addon2">Precio Máximo</span>
                        <input type="number" id="inputPvp" @bind="filtroPvp" class="form-control" placeholder="0.00">
                    </div>
                </div>

                @* Botón Buscar *@
                <div class="col">
                    <button type="button" class="btn btn-primary" @onclick=@BuscarBocadillos id="searchBocadillos">Buscar</button>
                </div>
            </div>

            <div class="row">
                @if (Bocadillos == null)
                {
                    <p>Cargando bocadillos...</p>
                }
                else
                {
                    <div class="mh-100 table-responsive">
                        <table class="table table-condensed table-hover" id="TableOfBocadillos">
                            <thead>
                                <tr>
                                    <th>Nombre</th>
                                    <th>PVP</th>
                                    <th>Tamaño</th>
                                    <th>Tipo de Pan</th>
                                    <th>Seleccionar</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var bocadillo in Bocadillos)
                                {
                                    <tr id="BocadilloData_@bocadillo.Nombre">
                                        <td>@bocadillo.Nombre</td>
                                        <td>@bocadillo.Pvp.ToString("C")</td>
                                        <td>@bocadillo.Tamano</td>
                                        <td>@bocadillo.TipoPan</td>
                                        <td>
                                            @* CAMBIO CLAVE: Botón ADD en vez de Checkbox, igual que el modelo *@
                                            <button class="btn btn-outline-secondary" id="bocadilloToAdd_@bocadillo.Nombre"
                                                    @onclick="@(() => AddBocadillo(bocadillo))">
                                                Añadir
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>

        @* COLUMNA DERECHA (2): CARRITO DE SELECCIONADOS *@
        <div class="col-2" hidden="@hideReviewCart">
            <div class="row">
                <h3>Seleccionados</h3>
            </div>
            @* Iteramos sobre los items ya guardados en el estado *@
            @foreach (var item in reseñaActual.ReseñaItemDTOs)
            {
                <div class="row mb-1">
                    @* Botón para eliminar del carrito (igual que el modelo) *@
                    <button type="button" class="btn btn-light border" id="removeBocadillo_@item.Nombre"
                            @onclick="@(() => RemoveBocadilloItem(item))">
                        x @item.Nombre - @item.Pvp.ToString("C")
                    </button>
                </div>
            }
            <div class="row mt-3">
                <button type="button" class="btn btn-primary" id="createReviewButton" @onclick=@NavegarFormularioReseña>
                    Crear Reseña
                </button>
            </div>
        </div>

    </div>
</div>

@code {
    // 1. Propiedades visuales
    private bool hideReviewCart { get { return reseñaActual.ReseñaItemDTOs.Count == 0; } }
    private bool hideErrors { get { return errors.Length == 0; } }
    private string errors = "";

    // 2. Filtros (eliminamos fechas, mantenemos los tuyos)
    private string? filtroNombre { get; set; }
    private double? filtroPvp { get; set; }

    // 3. Datos
    private ICollection<BocadilloForReseñaDTO> Bocadillos;

    // Acceso directo al DTO del estado para iterar en el carrito
    private ReseñaCreateDTO reseñaActual => estadoReseña.Reseña;

    // Métodos del Modelo adaptados

    // Botón "Add" de la tabla
    private void AddBocadillo(BocadilloForReseñaDTO bocadillo)
    {
        estadoReseña.AddBocadilloAReseña(bocadillo);
        // Forzamos repintado para que aparezca en la columna derecha inmediatamente
        StateHasChanged();
    }

    // Botón "x" del carrito derecho
    private void RemoveBocadilloItem(ReseñaItemDTO item)
    {
        estadoReseña.RemoveBocadilloDeReseña(item);
    }

    public async void BuscarBocadillos()
    {
        try
        {
            Bocadillos = await apiclient.GetBocadillosForReseñaAsync(filtroNombre, filtroPvp);
            errors = "";

            if (Bocadillos == null) Bocadillos = new List<BocadilloForReseñaDTO>();
        }
        catch (ApiException ex)
        {
            logger.LogError($"{DateTime.Now} Error: {ex}");
            errors = "Error conectando con el sistema";
            Bocadillos = new List<BocadilloForReseñaDTO>();
        }
        StateHasChanged();
    }

    protected override async Task OnInitializedAsync()
    {
        // Carga inicial
        BuscarBocadillos();
    }

    private void NavegarFormularioReseña()
    {
        navigation.NavigateTo("/Reseña/PostCrearReseña");
    }
}
      